NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=ciao@dietsprintai.com
NEXT_PUBLIC_LEGAL_CONTROLLER="Titolare da definire"
NEXT_PUBLIC_LEGAL_ADDRESS="Indirizzo sede da definire"
NEXT_PUBLIC_LEGAL_VAT="P.IVA / codice fiscale da definire"
NEXT_PUBLIC_DPO_EMAIL=

# Medical screening behaviour: warn (draft plan + review warning) or block (no automatic plan).
# Decision pending legal/nutritionist review; keep in sync between Vercel and local.
NEXT_PUBLIC_MEDICAL_SCREENING_MODE=warn

# Auth.js
# Generate a random server-only secret. Never expose it as NEXT_PUBLIC_*.
AUTH_SECRET=

# Supabase
# Create a Supabase project, then copy Project URL and anon public key here.
# Use a separate Supabase project for Vercel Preview/staging.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin access
# Use Supabase Auth user metadata/app metadata for role=admin, or list trusted users here.
ADMIN_EMAILS=
ADMIN_USERNAMES=rdladmin
PREMIUM_EMAILS=

# Server-only keys must never be exposed in the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Key id of the legacy HS256 secret shown in Settings > JWT Keys (needed when the project signs with JWKS keys).
SUPABASE_JWT_KEY_ID=

# Stripe Premium one-time checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# AI provider (server-side coach and AI plan generation)
# AI_PROVIDER=auto picks Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI.
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Debug endpoints
# Keep false/empty in production unless you are actively diagnosing auth.
DEBUG_AUTH_ENDPOINT=

# Email
# Create a Resend API key with sending access for dietsprintai.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Diet Sprint AI <no-reply@dietsprintai.com>"
PRIVACY_NOTIFICATION_EMAIL=
